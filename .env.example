# Example settings for Flawrence. Copy this file to `.env` and fill in what you use.
# The runner loads `.env` from the working directory automatically.

# --- LLM provider credentials (pick the provider(s) your models use) ---------
# Anthropic (anthropic/* models):
# ANTHROPIC_API_KEY=sk-ant-...

# Cloudflare Workers AI (workers-ai/* models):
# CLOUDFLARE_API_TOKEN=...
# CLOUDFLARE_ACCOUNT_ID=...

# OpenAI Responses API (openai/* models):
# OPENAI_API_KEY=sk-...

# Custom OpenAI-compatible provider (FLAWRENCE_PROVIDER_<NAME>_<BASE_URL|API_KEY>);
# the lowercased <NAME> becomes the model prefix, e.g. llmbase/z-ai/glm-5.2:
# FLAWRENCE_PROVIDER_LLMBASE_BASE_URL=https://api.llmbase.ai/v1
# FLAWRENCE_PROVIDER_LLMBASE_API_KEY=sk-...

# --- Runtime ------------------------------------------------------------------
# Browser launcher (required when binding outside loopback, including Docker):
# FLAWRENCE_WEB_PASSWORD=choose-a-long-password
# FLAWRENCE_WORKSPACE_DIR=/workspace/project
# FLAWRENCE_ARTIFACTS_BASE_DIR=/artifacts/project
# PORT=8080
# Newest detailed dashboard events retained per run (positive integer; default 1000):
# FLAWRENCE_WEB_MAX_EVENTS=1000
# Active second-level agents across all runs (positive integer; default 40):
# FLAWRENCE_MAX_PARALLEL_AGENTS=4
# Linux RSS watchdog threshold per direct subagent tree, in MiB (unset/blank = off).
# Deeper agents share the same allowance; sampled every ~100 ms, NOT a hard RAM ceiling.
# No cgroup delegation or elevated container permissions needed. See docs/agent-memory.md.
# FLAWRENCE_AGENT_MEMORY_MB=1024

# Override the model for every agent (eval runs use this):
# FLAWRENCE_MODEL=anthropic/claude-sonnet-4-20250514

# Budgets (optional):
# MAX_ITERATIONS=500
# MAX_TOKENS=65536
# Combined input/output window; enables proactive checkpoints without provider discovery:
# MAX_CONTEXT_TOKENS=524288
# MAX_COST_USD=50
# MAX_TOTAL_TOKENS=20000000

# --- Optional external tools --------------------------------------------------
# Trailmark code-graph (callers/callees/entrypoints; adds a query tier):
# TRAILMARK_BIN=~/.venv-trailmark/bin/trailmark
# CommitRaider (richer git-history analysis):
# COMMITRAIDER_PATH=/usr/local/bin/commitraider

# --- Remote submission (rarely needed; hard-gated) ---------------------------
# VULN_INGEST_ENDPOINT=https://...
# VULN_INGEST_TOKEN_PATH=/path/to/token
# FLAWRENCE_VULN_INGEST_LIVE=1        # only when an explicitly requested live submission
# GITHUB_TOKEN=ghp_...              # GitHub-advisory tools
